# RainCheck Environment Configuration Example
# Copy this file to .env and configure your local credentials as needed.
# RainCheck operates 100% offline using deterministic fallbacks if no API keys are provided.

# Optional: OpenAI API Key for AI Assistant (not required for standard app operation)
OPENAI_API_KEY=your_openai_api_key_here

# Weather API Endpoints
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast

# Optional Third-Party Meteorological Service Keys (Documented Team Fallbacks)
TAHMO_API_KEY=your_tahmo_api_key_placeholder
GOOGLE_WEATHER_API_KEY=your_google_weather_api_key_placeholder

# Operational Threshold Configuration
RAIN_EVENT_THRESHOLD_MM=1.0
MIN_LEAD_HOURS=6
